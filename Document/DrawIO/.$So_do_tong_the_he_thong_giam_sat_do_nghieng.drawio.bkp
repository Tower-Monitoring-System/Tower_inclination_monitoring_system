      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="03_-_Master,_Cloud_và_Website" name="03 - Master, Cloud và Website">
    <mxGraphModel dx="1920" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p3_title" value="&lt;b&gt;MASTER → CLOUD → WEBSITE — BẢO TOÀN DỮ LIỆU, LƯU TRỮ VÀ GIÁM SÁT&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px;color:#5B6472&quot;&gt;Chi tiết ACK / Persistent Queue / Fire-and-forget / Supabase / Web logic&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1840" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="p3_mlane" value="MASTER ESP32" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E6;strokeColor=#E08A1E;strokeWidth=2;fontSize=18;fontStyle=1;verticalAlign=top;align=center;spacingTop=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="45" y="110" width="610" height="890" as="geometry"/>
        </mxCell>
        <mxCell id="p3_clane" value="GOOGLE CLOUD / SUPABASE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0ECFF;strokeColor=#7B61C9;strokeWidth=2;fontSize=18;fontStyle=1;verticalAlign=top;align=center;spacingTop=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="675" y="110" width="610" height="890" as="geometry"/>
        </mxCell>
        <mxCell id="p3_wlane" value="WEB FRONTEND" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF8EF;strokeColor=#4C9A65;strokeWidth=2;fontSize=18;fontStyle=1;verticalAlign=top;align=center;spacingTop=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1305" y="110" width="570" height="890" as="geometry"/>
        </mxCell>
        <mxCell id="p3_rx" value="&lt;b&gt;1. Nhận LoRa DATA&lt;/b&gt;&lt;br&gt;byte parser → MAGIC/version/type/CRC&lt;br&gt;chỉ nhận Node ID = 1&lt;br&gt;duplicate history&lt;br&gt;storeTelemetry() nếu chưa có mẫu pending" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E08A1E;strokeWidth=2;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="165" width="250" height="165" as="geometry"/>
        </mxCell>
        <mxCell id="p3_enqueue" value="&lt;b&gt;2. enqueue Persistent Queue&lt;/b&gt;&lt;br&gt;validate X/Y/Z/Battery&lt;br&gt;persist record vào NVS trước khi trả QUEUED&lt;br&gt;max 32 records&lt;br&gt;FULL / STORAGE_ERROR → giữ telemetry để retry enqueue" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#FFFDF8;strokeColor=#E08A1E;strokeWidth=2;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="365" y="165" width="255" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="p3_ack2" value="&lt;b&gt;3. ACK về Node&lt;/b&gt;&lt;br&gt;chỉ sau QUEUED hoặc DUPLICATE&lt;br&gt;ACK_ACCEPTED / ACK_DUPLICATE&lt;br&gt;nếu queue lỗi/đầy → không ACK&lt;br&gt;→ Node tự retry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E08A1E;strokeWidth=2;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="395" width="250" height="155" as="geometry"/>
        </mxCell>
        <mxCell id="p3_upload" value="&lt;b&gt;4. Uploader task&lt;/b&gt;&lt;br&gt;Wi‑Fi sẵn sàng + timestamp hợp lệ&lt;br&gt;1–2 record → single POST&lt;br&gt;3–32 → immutable FIFO batch&lt;br&gt;TLS/write lỗi → giữ queue + exponential backoff" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E08A1E;strokeWidth=2;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="365" y="395" width="255" height="185" as="geometry"/>
        </mxCell>
        <mxCell id="p3_ff" value="&lt;b&gt;5. Sau khi ghi đủ request&lt;/b&gt;&lt;br&gt;flush → stop TLS → removeFront()&lt;br&gt;&lt;br&gt;&lt;b&gt;Không đọc response&lt;/b&gt;&lt;br&gt;HTTP status / JSON không ảnh hưởng dequeue" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFFBE6;strokeColor=#C9A227;fontSize=13;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="365" y="635" width="255" height="155" as="geometry"/>
        </mxCell>
        <mxCell id="p3_master_support" value="&lt;b&gt;Hạ tầng Master&lt;/b&gt;&lt;br&gt;ESP32WiFiPortal tự reconnect&lt;br&gt;NTP pool.ntp.org + time.nist.gov UTC+7&lt;br&gt;GPIO35: click clear queue / hold 3 s portal&lt;br&gt;OLED hiển thị Wi‑Fi · LoRa · pending uploads" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E08A1E;strokeWidth=2;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="650" width="250" height="205" as="geometry"/>
        </mxCell>
        <mxCell id="p3_gas_write" value="&lt;b&gt;Apps Script — telemetry write&lt;/b&gt;&lt;br&gt;token + action&lt;br&gt;validate towerId=TWR-01 / nodeId=1&lt;br&gt;messageId + values + timestamp&lt;br&gt;ScriptLock 120 s&lt;br&gt;single / batch" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7B61C9;strokeWidth=2;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="715" y="165" width="250" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="p3_dedup" value="&lt;b&gt;Idempotent storage&lt;/b&gt;&lt;br&gt;Sheet: TWR-01&lt;br&gt;A:F Date / Time / X / Y / Z / Battery&lt;br&gt;&lt;br&gt;__TELEMETRY_DEDUP&lt;br&gt;Key + Status + TargetRow + Fingerprint" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#FFFFFF;strokeColor=#7B61C9;strokeWidth=2;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1000" y="165" width="245" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="p3_auth" value="&lt;b&gt;Supabase authentication&lt;/b&gt;&lt;br&gt;username-login Edge Function&lt;br&gt;Supabase Auth session&lt;br&gt;profiles.role ∈ {owner, operator}&lt;br&gt;frontend sessionStorage" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7B61C9;strokeWidth=2;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="715" y="465" width="250" height="165" as="geometry"/>
        </mxCell>
        <mxCell id="p3_edge" value="&lt;b&gt;sensor-data Edge Function&lt;/b&gt;&lt;br&gt;JWT → getUser → role check&lt;br&gt;validate towerId&lt;br&gt;POST Apps Script với shared secret&lt;br&gt;timeout 10 s&lt;br&gt;normalize tối đa 20,000 rows" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7B61C9;strokeWidth=2;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1000" y="465" width="245" height="185" as="geometry"/>
        </mxCell>
        <mxCell id="p3_gas_read" value="&lt;b&gt;Apps Script — read path&lt;/b&gt;&lt;br&gt;nếu request có towerId → đọc Sheet cùng tên&lt;br&gt;không có → fallback SENSOR_SHEET_NAME&lt;br&gt;normalize Date/Time/X/Y/Z/Battery&lt;br&gt;trả JSON data + meta" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7B61C9;strokeWidth=2;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="715" y="730" width="530" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="p3_browser" value="&lt;b&gt;AuthService + SensorDataService&lt;/b&gt;&lt;br&gt;guardDashboard()&lt;br&gt;Bearer JWT + publishable key&lt;br&gt;POST sensor-data Edge Function&lt;br&gt;polling mặc định 45 s&lt;br&gt;AbortController + timeout 12 s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4C9A65;strokeWidth=2;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1340" y="165" width="240" height="185" as="geometry"/>
        </mxCell>
        <mxCell id="p3_registry" value="&lt;b&gt;Tower Registry&lt;/b&gt;&lt;br&gt;System Settings quản lý Tower ID&lt;br&gt;Tower ID = tên Google Sheet tab&lt;br&gt;Towers/List/Alerts dùng chung registry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4C9A65;strokeWidth=2;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1610" y="165" width="230" height="155" as="geometry"/>
        </mxCell>
        <mxCell id="p3_avg" value="&lt;b&gt;Shared orientationAveraging&lt;/b&gt;&lt;br&gt;rolling average 3 samples / tower&lt;br&gt;reset window nếu gap &amp;gt; 90 phút&lt;br&gt;wrap X/Y quanh ±180°&lt;br&gt;delta = Average − Initial calibration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4C9A65;strokeWidth=2;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1340" y="415" width="500" height="165" as="geometry"/>
        </mxCell>
        <mxCell id="p3_thresh" value="&lt;b&gt;Đánh giá trạng thái&lt;/b&gt;&lt;br&gt;threshold mặc định: X=Y=Z=0.5°&lt;br&gt;Warning: ratio ≥ 1&lt;br&gt;Critical: ratio ≥ 1.5&lt;br&gt;chọn trục có ratio cao nhất&lt;br&gt;&lt;br&gt;Battery: Warning &amp;lt; minimumVoltage (mặc định 12.8 V), Critical &amp;lt; 10 V" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4C9A65;strokeWidth=2;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1340" y="625" width="500" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="p3_pages" value="&lt;b&gt;Towers · List · Alerts&lt;/b&gt;&lt;br&gt;lọc Day / Month / Custom&lt;br&gt;trend X/Y + 3-axis orientation&lt;br&gt;alert event active/resolved&lt;br&gt;xuất XLSX&lt;br&gt;&lt;br&gt;MQTT hiện tắt (enabled=false)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4C9A65;strokeWidth=2;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1340" y="850" width="245" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="p3_settings" value="&lt;b&gt;System Settings&lt;/b&gt;&lt;br&gt;calibration / threshold / battery / Tower registry&lt;br&gt;&lt;br&gt;&lt;i&gt;Esp32SettingsAdapter hiện là adapter local phía browser; chưa ghi thật xuống ESP32.&lt;/i&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFFBE6;strokeColor=#C9A227;fontSize=13;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1610" y="850" width="230" height="115" as="geometry"/>
        </mxCell>
