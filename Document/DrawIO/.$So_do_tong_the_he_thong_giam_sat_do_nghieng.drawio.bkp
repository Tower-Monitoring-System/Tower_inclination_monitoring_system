        <mxCell id="p1_sensors" value="&lt;b&gt;Cảm biến&lt;/b&gt;&lt;br&gt;MPU6050 (I²C1 GPIO18/19)&lt;br&gt;LM35 (GPIO4)&lt;br&gt;LiFePO₄ 4S / Vbat GPIO27&lt;br&gt;BAT_MEAS GPIO26" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90E2;strokeWidth=2;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="65" y="175" width="190" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="p1_node" value="&lt;b&gt;ESP32 Node — TWR-01 / Node 1&lt;/b&gt;&lt;br&gt;&lt;br&gt;• DMP + lọc Fast Angle&lt;br&gt;• Structural Tilt chống rung&lt;br&gt;• LM35 + Battery calibration&lt;br&gt;• cooperative non-blocking&lt;br&gt;• tạo Message ID + CRC + validFlags" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90E2;strokeWidth=2;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="275" y="175" width="195" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="p1_oled_node" value="&lt;b&gt;OLED SH1106G 1.3”&lt;/b&gt;&lt;br&gt;GPIO21/22&lt;br&gt;Nút GPIO23 → bật 15 s&lt;br&gt;hiển thị X/Y/Z, Temp, Battery, LoRa" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90E2;strokeWidth=2;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="65" y="365" width="190" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="p1_lora_node" value="&lt;b&gt;LoRa AS32‑TTL‑100 / SX1278&lt;/b&gt;&lt;br&gt;UART2 GPIO16/17&lt;br&gt;AUX 34 · M0 33 · M1 32&lt;br&gt;&lt;br&gt;Radio ngủ giữa các chu kỳ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90E2;strokeWidth=2;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="275" y="440" width="195" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="p1_node_cycle" value="&lt;b&gt;Chu kỳ telemetry&lt;/b&gt;&lt;br&gt;1 mẫu / 1 giờ&lt;br&gt;Structural valid → gửi Structural X/Y/Z&lt;br&gt;không valid → Fast fallback + cờ chất lượng" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFFBE6;strokeColor=#C9A227;fontSize=13;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="65" y="535" width="190" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="p1_master_lora" value="&lt;b&gt;MasterLoRaManager&lt;/b&gt;&lt;br&gt;UART2 GPIO16/17&lt;br&gt;AUX34 · M0 25 · M1 26&lt;br&gt;&lt;br&gt;Parser byte + CRC&lt;br&gt;lọc Node ID / duplicate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E08A1E;strokeWidth=2;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="550" y="175" width="175" height="155" as="geometry"/>
        </mxCell>
        <mxCell id="p1_master_core" value="&lt;b&gt;ESP32 Master&lt;/b&gt;&lt;br&gt;loop non-blocking&lt;br&gt;ưu tiên nhận LoRa&lt;br&gt;&lt;br&gt;NTP UTC+7&lt;br&gt;OLED dashboard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E08A1E;strokeWidth=2;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="750" y="175" width="170" height="155" as="geometry"/>
        </mxCell>
        <mxCell id="p1_queue" value="&lt;b&gt;Persistent Queue — NVS&lt;/b&gt;&lt;br&gt;tối đa 32 records&lt;br&gt;FIFO + checksum + generation&lt;br&gt;dedup theo Node ID + Message ID&lt;br&gt;&lt;br&gt;&lt;b&gt;Persist thành công rồi mới ACK Node&lt;/b&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#FFFDF8;strokeColor=#E08A1E;strokeWidth=2;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="550" y="390" width="175" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="p1_uploader" value="&lt;b&gt;GoogleSheetUploader&lt;/b&gt;&lt;br&gt;FreeRTOS task riêng&lt;br&gt;1–2 mẫu: gửi đơn&lt;br&gt;3–32 mẫu: batch snapshot&lt;br&gt;retry exponential 5 s → 300 s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF8;strokeColor=#E08A1E;strokeWidth=2;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="750" y="390" width="170" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="p1_wifi" value="&lt;b&gt;Wi‑Fi / Config Portal&lt;/b&gt;&lt;br&gt;ESP32WiFiPortal&lt;br&gt;SSID: Tower‑Master‑Setup&lt;br&gt;IP portal: 200.5.29.8&lt;br&gt;Giữ GPIO35 3 s → mở portal&lt;br&gt;Nhấn/nhả → clear queue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E08A1E;strokeWidth=2;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="550" y="635" width="370" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="p1_fire" value="&lt;b&gt;Fire‑and‑forget HTTPS&lt;/b&gt;&lt;br&gt;connect TLS → POST header → JSON payload → kiểm tra write đủ byte → flush → close&lt;br&gt;&lt;b&gt;Không đọc HTTP status / JSON response&lt;/b&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFFBE6;strokeColor=#C9A227;fontSize=13;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="550" y="815" width="370" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="p1_gas" value="&lt;b&gt;Google Apps Script Web App&lt;/b&gt;&lt;br&gt;doPost()&lt;br&gt;shared secret + validation&lt;br&gt;single / batch append&lt;br&gt;ScriptLock" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7B61C9;strokeWidth=2;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1005" y="190" width="185" height="155" as="geometry"/>
        </mxCell>
        <mxCell id="p1_sheet" value="&lt;b&gt;Google Spreadsheet&lt;/b&gt;&lt;br&gt;Sheet telemetry: TWR-01&lt;br&gt;A:F = Date, Time, X, Y, Z, Battery&lt;br&gt;&lt;br&gt;__TELEMETRY_DEDUP&lt;br&gt;Message ID / fingerprint" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#FFFFFF;strokeColor=#7B61C9;strokeWidth=2;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1210" y="190" width="175" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="p1_sup_auth" value="&lt;b&gt;Supabase Auth + profiles&lt;/b&gt;&lt;br&gt;username-login Edge Function&lt;br&gt;session + role&lt;br&gt;owner / operator" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7B61C9;strokeWidth=2;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1005" y="505" width="185" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="p1_sensor_edge" value="&lt;b&gt;sensor-data Edge Function&lt;/b&gt;&lt;br&gt;kiểm tra JWT + role&lt;br&gt;POST tới Apps Script bằng shared secret&lt;br&gt;validate/normalize rows" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7B61C9;strokeWidth=2;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1210" y="500" width="175" height="155" as="geometry"/>
        </mxCell>
        <mxCell id="p1_cloud_note" value="&lt;b&gt;Hai chiều dùng cùng Apps Script&lt;/b&gt;&lt;br&gt;• Master → ghi telemetry TWR-01&lt;br&gt;• Website → yêu cầu đọc Sheet theo towerId&lt;br&gt;&lt;br&gt;Website không truy cập trực tiếp ESP32/Google Sheet." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFFBE6;strokeColor=#C9A227;fontSize=13;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1005" y="735" width="380" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="p1_user" value="&lt;b&gt;Người dùng&lt;/b&gt;&lt;br&gt;Sign in → Supabase&lt;br&gt;Phiên đăng nhập trong sessionStorage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4C9A65;strokeWidth=2;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1470" y="175" width="175" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="p1_dashboard" value="&lt;b&gt;Web Dashboard&lt;/b&gt;&lt;br&gt;Towers · List · Alerts · System settings&lt;br&gt;&lt;br&gt;SensorDataService polling ~45 s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4C9A65;strokeWidth=2;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1665" y="175" width="185" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="p1_logic" value="&lt;b&gt;Xử lý giám sát trên Web&lt;/b&gt;&lt;br&gt;Rolling average 3 mẫu&lt;br&gt;reset nếu gap &amp;gt; 90 phút&lt;br&gt;Average − Initial calibration&lt;br&gt;threshold mặc định X/Y/Z = 0.5°&lt;br&gt;Critical = 1.5 × threshold" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4C9A65;strokeWidth=2;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1470" y="405" width="380" height="185" as="geometry"/>
        </mxCell>
        <mxCell id="p1_alerts" value="&lt;b&gt;Cảnh báo / hiển thị&lt;/b&gt;&lt;br&gt;Inclination: Normal / Warning / Critical&lt;br&gt;Battery warning mặc định 12.8 V&lt;br&gt;Battery critical 10.0 V&lt;br&gt;3D orientation + trend + lịch sử + XLSX" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4C9A65;strokeWidth=2;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1470" y="635" width="380" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="p1_settings_note" value="&lt;b&gt;Lưu ý source hiện tại&lt;/b&gt;&lt;br&gt;System Settings dùng &lt;i&gt;Esp32SettingsAdapter&lt;/i&gt; phía browser (giả lập/local state). Chưa có đường API thật từ website để ghi cấu hình trực tiếp xuống Master/Node ESP32.&lt;br&gt;MQTT_CONFIG.enabled = false." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFFBE6;strokeColor=#C9A227;fontSize=13;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
