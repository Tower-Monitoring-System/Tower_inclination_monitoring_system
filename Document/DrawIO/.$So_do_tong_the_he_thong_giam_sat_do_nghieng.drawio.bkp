        <mxCell id="p1_title" value="&lt;b&gt;HỆ THỐNG GIÁM SÁT ĐỘ NGHIÊNG TOWER — SƠ ĐỒ TỔNG THỂ&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px;color:#5B6472&quot;&gt;Luồng thực tế theo Node(3) + Master(8) + Tower_inclination_monitoring_system (02/09/2026)&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontColor=#1F2937;" vertex="1" parent="1">
