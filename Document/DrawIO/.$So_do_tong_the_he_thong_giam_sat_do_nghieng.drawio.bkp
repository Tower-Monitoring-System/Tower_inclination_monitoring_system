        <mxCell id="lane_web" value="TRÌNH DUYỆT / DASHBOARD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF8EF;strokeColor=#4C9A65;strokeWidth=2;fontSize=18;fontStyle=1;verticalAlign=top;align=center;spacingTop=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1435" y="105" width="450" height="855" as="geometry"/>
