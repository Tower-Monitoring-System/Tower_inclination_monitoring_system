        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p2_title" value="&lt;b&gt;NODE ESP32 — THU THẬP, LỌC VÀ TRUYỀN TELEMETRY&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px;color:#5B6472&quot;&gt;Node(3): TowerSensors + NodeLoRaManager + OLED&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="50" y="20" width="1820" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="p2_input_lane" value="NGÕ VÀO / PHẦN CỨNG" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F3FF;strokeColor=#4A90E2;strokeWidth=2;fontSize=18;fontStyle=1;verticalAlign=top;align=center;spacingTop=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="45" y="110" width="350" height="890" as="geometry"/>
        </mxCell>
        <mxCell id="p2_proc_lane" value="TOWERSENSORS — XỬ LÝ NON-BLOCKING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F8FC;strokeColor=#607D9B;strokeWidth=2;fontSize=18;fontStyle=1;verticalAlign=top;align=center;spacingTop=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="415" y="110" width="660" height="890" as="geometry"/>
        </mxCell>
        <mxCell id="p2_tx_lane" value="SNAPSHOT / LORA STATE MACHINE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E6;strokeColor=#E08A1E;strokeWidth=2;fontSize=18;fontStyle=1;verticalAlign=top;align=center;spacingTop=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1095" y="110" width="470" height="890" as="geometry"/>
        </mxCell>
        <mxCell id="p2_ui_lane" value="HIỂN THỊ / ĐIỀU KHIỂN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF8EF;strokeColor=#4C9A65;strokeWidth=2;fontSize=18;fontStyle=1;verticalAlign=top;align=center;spacingTop=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1585" y="110" width="290" height="890" as="geometry"/>
        </mxCell>
        <mxCell id="p2_mpu" value="&lt;b&gt;MPU6050&lt;/b&gt;&lt;br&gt;I²C1 SDA18 / SCL19&lt;br&gt;DMP FIFO&lt;br&gt;Accel + Gyro + Quaternion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90E2;strokeWidth=2;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="75" y="175" width="285" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="p2_lm35" value="&lt;b&gt;LM35 — GPIO4&lt;/b&gt;&lt;br&gt;analogReadMilliVolts()&lt;br&gt;3V3 ESP32" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90E2;strokeWidth=2;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="75" y="405" width="285" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="p2_bat" value="&lt;b&gt;LiFePO₄ 4S&lt;/b&gt;&lt;br&gt;BAT_MEAS GPIO26&lt;br&gt;Vbat ADC GPIO27&lt;br&gt;R7=29.60kΩ / R8=7.57kΩ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90E2;strokeWidth=2;fontSize=14;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="75" y="625" width="285" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="p2_btn" value="&lt;b&gt;Nút OLED GPIO23&lt;/b&gt;&lt;br&gt;active LOW&lt;br&gt;debounce 35 ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A90E2;strokeWidth=2;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="75" y="825" width="285" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="p2_dmp" value="&lt;b&gt;DMP packet → median 5 mẫu&lt;/b&gt;&lt;br&gt;Roll / Pitch / Yaw&lt;br&gt;loại gravity để tính vibration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#607D9B;strokeWidth=2;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="455" y="160" width="275" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="p2_fast" value="&lt;b&gt;FAST ANGLE&lt;/b&gt;&lt;br&gt;median + EMA&lt;br&gt;τ ≈ 0.20 s&lt;br&gt;phản hồi nhanh cho OLED&lt;br&gt;X=Roll · Y=Pitch · Z=Yaw" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#607D9B;strokeWidth=2;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="455" y="320" width="275" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="p2_vibration" value="&lt;b&gt;Vibration detector&lt;/b&gt;&lt;br&gt;linear accel + gyro&lt;br&gt;score EMA&lt;br&gt;enter 0.90 / exit 0.45&lt;br&gt;&lt;i&gt;chỉ gate Structural Tilt&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#607D9B;strokeWidth=2;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="760" y="160" width="275" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="p2_struct" value="&lt;b&gt;STRUCTURAL TILT&lt;/b&gt;&lt;br&gt;30 bin × 100 ms ≈ 3 s&lt;br&gt;trim 4 mẫu mỗi phía&lt;br&gt;MAD ≤ 0.20°&lt;br&gt;deadband + persistence 2.5 s&lt;br&gt;X=Roll · Y=Pitch · Z=combined tilt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#607D9B;strokeWidth=2;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="760" y="340" width="275" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="p2_alarm" value="&lt;b&gt;Tilt alarm nội bộ Node&lt;/b&gt;&lt;br&gt;enter 1.00° · exit 0.70°&lt;br&gt;persistence 2 s&lt;br&gt;&lt;i&gt;tiltAlarmActive hiện không nằm trong packet LoRa&lt;/i&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFFBE6;strokeColor=#C9A227;fontSize=13;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="760" y="570" width="275" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="p2_temp_proc" value="&lt;b&gt;LM35 pipeline&lt;/b&gt;&lt;br&gt;10 ms/sample · 15 mẫu&lt;br&gt;warmup 2 · trimmed mean 3+3&lt;br&gt;calibration 384.0→335.2 mV&lt;br&gt;EMA α=0.18" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#607D9B;strokeWidth=2;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="455" y="525" width="275" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="p2_bat_proc" value="&lt;b&gt;Battery pipeline&lt;/b&gt;&lt;br&gt;đo mỗi 3 s&lt;br&gt;enable → settle 50 ms&lt;br&gt;15 mẫu / min 9 valid&lt;br&gt;trimmed mean → divider thực → calibration&lt;br&gt;EMA α=0.25 → tắt BAT_MEAS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#607D9B;strokeWidth=2;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="455" y="725" width="580" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="p2_snapshot" value="&lt;b&gt;Mỗi 1 giờ: wake LoRa → snapshot&lt;/b&gt;&lt;br&gt;Ưu tiên Structural Roll/Pitch/Tilt&lt;br&gt;Nếu Structural chưa valid:&lt;br&gt;Fast Roll/Pitch + tính combined tilt&lt;br&gt;→ set FLAG_ORIENTATION_FALLBACK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E08A1E;strokeWidth=2;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1130" y="180" width="400" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="p2_packet" value="&lt;b&gt;DataPacket — 23 bytes&lt;/b&gt;&lt;br&gt;MAGIC + version + type&lt;br&gt;nodeId=1 · messageId uint32&lt;br&gt;X/Y/Z centidegree&lt;br&gt;Temp · Battery mV · validFlags · CRC16" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E08A1E;strokeWidth=2;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1130" y="400" width="400" height="165" as="geometry"/>
        </mxCell>
        <mxCell id="p2_state" value="&lt;b&gt;LoRa state machine&lt;/b&gt;&lt;br&gt;SLEEP → WAKING → READY → SEND&lt;br&gt;WAIT ACK 1.5 s&lt;br&gt;timeout → RETRY 250 ms&lt;br&gt;tối đa 3 retries&lt;br&gt;SUCCESS / FAILED → SLEEP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E08A1E;strokeWidth=2;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1130" y="615" width="400" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="p2_ack" value="&lt;b&gt;ACK hợp lệ&lt;/b&gt;&lt;br&gt;nodeId + messageId khớp&lt;br&gt;status = ACCEPTED hoặc DUPLICATE&lt;br&gt;→ kết thúc phiên thành công" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFFBE6;strokeColor=#C9A227;fontSize=13;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1130" y="845" width="400" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="p2_oled" value="&lt;b&gt;OLED SH1106G&lt;/b&gt;&lt;br&gt;I²C0 GPIO21/22&lt;br&gt;mặc định sleep&lt;br&gt;&lt;br&gt;Nhấn GPIO23 → wake 15 s&lt;br&gt;refresh telemetry ≈ 15 FPS&lt;br&gt;hiển thị trạng thái LoRa" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4C9A65;strokeWidth=2;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1615" y="235" width="230" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="p2_status" value="&lt;b&gt;Trạng thái LoRa hiển thị&lt;/b&gt;&lt;br&gt;SLEEP · READY · SENDING&lt;br&gt;SUCCESS · RETRY · FAILED&lt;br&gt;DISCONNECTED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4C9A65;strokeWidth=2;fontSize=13;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1615" y="500" width="230" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="p2_nonblock" value="&lt;b&gt;Nguyên tắc vận hành&lt;/b&gt;&lt;br&gt;Không delay trong loop&lt;br&gt;TowerSensors.update()&lt;br&gt;NodeLoRa.update()&lt;br&gt;OLED chỉ update khi awake&lt;br&gt;yield() nhường CPU" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFFBE6;strokeColor=#C9A227;fontSize=13;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1615" y="720" width="230" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="p2e1" value="DMP FIFO" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p2_mpu" target="p2_dmp">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p2e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p2_dmp" target="p2_fast">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p2e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p2_dmp" target="p2_vibration">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p2e4" value="gate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p2_vibration" target="p2_struct">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p2e5" value="filtered Roll/Pitch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="p2_fast" target="p2_struct">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p2e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p2_struct" target="p2_alarm">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p2e7" value="ADC mV" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p2_lm35" target="p2_temp_proc">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p2e8" value="ADC mV" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p2_bat" target="p2_bat_proc">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p2e9" value="Structural / fallback" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p2_struct" target="p2_snapshot">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p2e10" value="fallback source" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="p2_fast" target="p2_snapshot">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p2e11" value="Temp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p2_temp_proc" target="p2_snapshot">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p2e12" value="Battery" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p2_bat_proc" target="p2_snapshot">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p2e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p2_snapshot" target="p2_packet">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p2e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p2_packet" target="p2_state">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p2e15" value="ACK từ Master" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="p2_ack" target="p2_state">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p2e16" value="Fast X/Y/Z + Temp + Battery" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p2_fast" target="p2_oled">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p2e17" value="nút wake" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p2_btn" target="p2_oled">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p2e18" value="status" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p2_state" target="p2_status">
